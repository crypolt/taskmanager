# --- service -------------------------------------------------------------
SERVICE_NAME=task-manager
LANGUAGE=ru
SERVER_ADDRESS=0.0.0.0:8080
LOG_LEVEL=debug
TRACE_MODE=true

# --- storage -------------------------------------------------------------
DB_PATH=taskmanager.db

# --- agent runner --------------------------------------------------------
WORKERS=3
MAX_PROMPT_CHARS=40000
MAX_PROMPT_TOKENS=8000
EXEC_TIMEOUT_SEC=600

# opencode CLI (https://opencode.ai). The binary must be on PATH or absolute.
OPENCODE_BIN=opencode
OPENCODE_AUTO_APPROVE=true
OPENCODE_PURE=true
OPENCODE_MCP=false
OPENCODE_STEPS=12
OPENCODE_IDLE_SEC=120

# optional: use your own opencode config instead of the generated one
OPENCODE_CONFIG_PATH=

# --- alternative providers (used when a route names them) ----------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
